APP_ENV=development
APP_NAME=questionnaire-intelligence
APP_VERSION=1.0.0
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=15
MAX_PDF_PAGES=100
REQUEST_TIMEOUT_SECONDS=90

# Límites adicionales. Los valores por defecto viven en Settings.
# MAX_XLSX_SHEETS=20
# MAX_XLSX_ROWS_PER_SHEET=5000
# MAX_IMAGE_PIXELS=40000000
# MAX_ZIP_UNCOMPRESSED_MB=100
# MAX_ZIP_ENTRIES=1000
# MAX_ZIP_RATIO=100
# MAX_OCR_PAGES=10
# OCR_LANGUAGES=spa+eng+ita
# MAX_CONCURRENT_OCR=2
# MAX_CONCURRENT_REQUESTS=8
# CONFIDENCE_THRESHOLD=0.70
# LLM_MAX_IMAGES=4
# LLM_MAX_INPUT_CHARS=40000
# LLM_IMAGE_MAX_SIDE=2048
# METRICS_TOKEN=

OPENAI_ENABLED=false
OPENAI_API_KEY=
# Modelo vigente con visión y salida estructurada. Nov 2026: gpt-6-luna.
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
OPENAI_MAX_CONCURRENT_REQUESTS=3

# openai | mock. mock solo para Locust; se rechaza si APP_ENV=production.
LLM_PROVIDER=openai
# LLM_MOCK_LATENCY_MS=50

OCR_ENABLED=true
TESSERACT_CMD=
